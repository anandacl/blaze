{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Blaze",
  "description": "Documentation for Blaze.",
  "colors": {
    "primary": "#EA580C",
    "light": "#FB923C",
    "dark": "#C2410C"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://github.com/anandacl/blaze"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "MarkdownSyntax",
              "CommonMarkRepresentations",
              "Jones",
              "essentials/code",
              "essentials/images",
              "essentials/navigation",
              "essentials/settings",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/claude-code",
              "ai-tools/cursor",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "/api-reference/openapi.json",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Mintlify docs",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Components",
          "href": "https://mintlify.com/docs/components",
          "icon": "shapes"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/anandacl/blaze",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Report an issue",
        "href": "https://github.com/anandacl/blaze/issues/new"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/anandacl/blaze"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/anandacl/blaze"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "search": {
    "prompt": "Search Blaze docs"
  }
}
